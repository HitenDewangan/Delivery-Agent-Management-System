NODE_ENV=development
PORT=4000
# Must match the values in the root .env used by docker-compose.yml
DATABASE_URL=postgresql://delivery_user:change_me@localhost:5432/delivery_agents
REDIS_URL=redis://localhost:6379
# One origin, or several separated by commas (no trailing slash needed)
CORS_ORIGIN=http://localhost:3000
# Cache lifetimes (seconds)
CACHE_TTL_LIST_SECONDS=60
CACHE_TTL_DETAIL_SECONDS=120
