generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  SCOOTER
  CAR
  VAN
}

model Agent {
  id          String       @id @default(uuid()) @db.Uuid
  fullName    String
  phone       String       @unique
  email       String       @unique
  serviceArea String
  status      AgentStatus  @default(ACTIVE)
  vehicleType VehicleType?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([serviceArea])
  @@index([createdAt])
  @@map("agents")
}
